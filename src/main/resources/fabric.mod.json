{
  "schemaVersion": 1,
  "id": "$id",
  "version": "$version",
  "name": "$libname",
  "description": "$description",
  "authors": $authors_list,
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/watermedia/",
    "sources": "https://github.com/$github",
    "issues": "https://github.com/$github/issues",
    "email": "SrRapero720@hotmail.com"
  },

  "license": "$license",
  "icon": "pack.png",
  "environment": "client",
  "jars": [
    { "file": "META-INF/jarjar/waterconfig-${waterconfig_version + '.jar'}" }
  ],
  "entrypoints": {
    "main": [
      "org.watermedia.bootstrap.FabricBootstrap"
    ]
  },
  "depends": {
    "watermedia_binaries": "*",
    "java": "$javarange"
  }
}
