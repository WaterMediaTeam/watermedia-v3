{
  "schemaVersion": 1,
  "id": "$id",
  "version": "$version",
  "name": "$libname",
  "description": "$description",
  "authors": $authors_list,
  "contributors": $contributors_list,
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/$id",
    "sources": "https://github.com/$github",
    "issues": "https://github.com/$github/issues",
    "email": "SrRapero720@hotmail.com"
  },

  "license": "$license",
  "icon": "pack.png",
  "environment": "*",
  "jars": $jars,
  "entrypoints": {
    "main": [
      "org.watermedia.bootstrap.FabricBootstrap"
    ]
  },
  "depends": {
    "minecraft": $minecraftfabric,
    "fabricloader": "$fabricrange",
    "java": "$javarange"
  },
  "breaks": {
    "watermedia_binaries": $binariesbreaks
  }
}
